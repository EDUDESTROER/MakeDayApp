<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="An unexpected error occurred.">
    <meta name="author" content="EDUDESTROER">
    <title>MakeDay - Workspace</title>
    <link rel="stylesheet" href="css/workspace-styles.min.css">
    <link rel="shortcut icon" href="icons/MakeDay_Icon.png" type="image/x-icon">
    <link rel="stylesheet" href="fontwesome/css/all.min.css">
    
</head>
<body>
    <div id="modal-warn" class="important-modal-warn" inert style="opacity: 0;">
        <div id="delete-account-wrapper" class="delete-account-wrapper" inert style="opacity: 0;">
            <div class="title-wrapper">
                <span>Delete Account: </span><span id="username-delete-account">...</span>
            </div>
            <div class="more-info">
                <span>This action is permanent and connot be undone!</span>
                <h3 class="more-info-title">The following data will be deleted:</h3>
                <ul>
                    <li>Profile information</li>
                    <li>Notes</li>
                    <li>Achievements</li>
                    <li>Streak history</li>
                    <li>Settings</li>
                    <li>Uploaded images</li>
                </ul>
            </div>
            <div class="wrapper-modal-warn-buttons modal-buttons">
                <button data-action="closeDeleteAccount" type="button" class="buttuns-purple-style"><span>Stay</span><i class="fa-solid fa-people-pulling"></i></button>
                <button data-action="openDeleteAccountSub" type="button" class="buttuns-red-style"><span>Delete Account</span><i class="fa-solid fa-person-walking"></i></button>
            </div>
            <div id="sub-modal-delete-account" class="sub-modal-delete-account" inert style="opacity: 0;">

                <div id="delete-account-sub-modal-one" class="wrapper-first-step">
                    <div class="wrapper-confirm-title">
                        Type DELETE to confirm
                    </div>
                    <div class="wrapper-confirm-delete">
                        <div id="delete-account-input-delete-info" class="wrapper-info-input"></div>
                        <input id="delete-account-input-delete" type="text">
                    </div>
                </div>
                <div id="delete-account-sub-modal-two" class="wrapper-first-step" style="display: none;">
                    <div class="wrapper-confirm-title">
                        Type your PASSWORD to confirm
                    </div>
                    <div class="wrapper-confirm-delete">
                        <div id="delete-account-input-password-info" class="wrapper-info-input">Incorrect password</div>
                        <input id="delete-account-input-password" type="password">
                    </div>
                </div>
                <div class="wrapper-sub-modal-delete-account-btn modal-buttons">
                    <button data-action="closeDeleteAccountSub" type="button" class="buttuns-purple-style"><span>Stay</span><i class="fa-solid fa-people-pulling"></i></button>
                    <button data-action="deleteAccount" type="button" class="buttuns-red-style"><span>Delete Account</span><i class="fa-solid fa-person-walking"></i></button>
                </div>
            </div>
        </div>
        <div id="change-account-info-wrapper" class="delete-account-wrapper" inert style="opacity: 0;">

            <div id="wrapper-change-account-first-step" class="wrapper-change-account-first-step">

                <div class="wrapper-title">
                    <span id="change-account-info-first-title">...</span>
                </div>
                <div class="wrapper-input">
                    <div id="change-account-info-first-input-response">
                        ...
                    </div>
                    <input id="change-account-info-first-input" type="email" placeholder="...">

                </div>

            </div>
            <div id="wrapper-change-account-last-step" class="wrapper-change-account-last-step">

                <div class="wrapper-title">
                    <span id="change-account-info-second-title">Type your PASSWORD to confirm</span>
                </div>
                <div class="wrapper-input">
                    <div id="change-account-info-second-input-response">
                        ...
                    </div>
                    <input id="change-account-info-second-input" type="password" placeholder="Password">

                </div>

            </div>

            <div class="wrapper-change-account-info-buttons modal-buttons">
                <button data-action="cancelChangeAccountInfo" type="button" class="buttuns-red-style"><span>Cancel</span><i class="fa-solid fa-x"></i></i></button>
                <button data-action="checkChangeAccountInfo" type="button" class="buttuns-purple-style"><span>Confirm</span><i class="fa-solid fa-check"></i></button>
            </div>

        </div>
        <div id="change-account-avatar-wrapper" class="delete-account-wrapper" inert style="opacity: 0;">
            <div class="change-account-avatar-inputs">

                <div class="wrapper-title">
                    <span>Change Avatar</span>
                </div>

                <div class="wrapper-result">
                    <img src="/uploads/avatares/default.png" id="change-account-avatar-result">
                </div>

                <div id="change-account-avatar-error-log">
                    
                </div>

                <div class="wrapper-inputs">
                    <label class="new-note-image">
                        <input hidden type="file" id="change-account-avatar-image" accept="image/*">
                        <div id="change-account-avatar-image-accept" class="note-btn buttuns-purple-style"><i class="fa-solid fa-folder-open"></i> Select a image</div>
                        <span id="change-account-avatar-image-name">image-name.jpg</span>
                    </label>
                    <input type="password" id="change-account-avatar-password" placeholder="Confirm with password">
                </div>

            </div>
            <div class="wrapper-change-account-info-buttons modal-buttons">
                <button data-action="cancelChangeAccountAvatar" type="button" class="buttuns-red-style"><span>Cancel</span><i class="fa-solid fa-x"></i></i></button>
                <button data-action="checkChangeAccountAvatar" type="button" class="buttuns-purple-style"><span>Confirm</span><i class="fa-solid fa-check"></i></button>
            </div>
        </div>
    </div>
    <div id="exit-menus" data-action="exit-menus" style="opacity: 0;" inert></div>
    <div id="configs-menu" style="opacity: 0;" inert>
        <button title="Close menu" type="button" data-action="unShowConfigs" data-target="#configs-menu" class="buttuns-purple-style"><i class="fa-solid fa-square-xmark"></i></button>
        <div class="wrapper-configs-menu">
            <div class="left-bar-configs-menu" id="left-bar-configs-menu">
                <!--Dynamically Generated-->
            </div>
            <div class="configs-content" id="configs-content" style="opacity: 0;" inert>
                <button id="return-menu-options" title="Return menu" type="button" data-action="unShowConfigs" data-target="#configs-content" class="buttuns-purple-style"><i class="fa-solid fa-angle-left"></i></button>
                <!--Dynamically Generated--> 
            </div>
        </div>
    </div>
    <div id="user-menu" style="opacity: 0;" inert>
        <div class="wrapper-user-menu-header">
            <button type="button" title="Close user menu" data-action="showTarget" data-target="#smart-dashboard" class="buttuns-purple-style"><i class="fa-solid fa-angle-left"></i></button>
            <span>My profile</span>
            <button type="button" title="Close user menu" data-action="unShowUserMenu" data-target="#configs-menu" class="buttuns-purple-style"><i class="fa-solid fa-gear"></i></button>
        </div>
        <div class="wrapper-user-menu">
            <div class="wrapper-user-info">
                <div class="wrapper-user-menu-picture">
                    <img id="user-menu-picture" src="" alt="user avatar">
                </div>
                <div class="wrapper-user-menu-more-info">
                    <div id="wrapper-user-menu-username" class="wrapper-user-menu-username">
                        <span>loading...</span>
                    </div>
                    <div id="wrapper-user-menu-email" class="wrapper-user-menu-email">
                        loading...
                    </div>
                </div>
            </div>
            <div class="wrapper-user-menu-flame grow-item-effect">
                <div class="flame-card">
                    <div class="wrapper-flame-img">
                        <img id="flame-img-el" src="/icons/flameIcons/0days.png" alt="a fire icon">
                    </div>
                    <div class="wrapper-flame-streak">
                        <span>Streak</span>
                        <div>
                            <span id="flame-days-output">...</span>
                            <span>Days</span>
                        </div>
                    </div>
                </div>
                <div class="day-streak-card">
                    <div class="wrapper-mon">
                        <div class="wrapper-progress-bar">
                            <div class="progress-bar">
                                <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 100 100"> 
                                    <defs>
                                        <linearGradient id="gradient-color"> 
                                            <stop offset= "0%" stop-color="#2A772A" />
                                            <stop offset="1001" stop-color="#04CD04" /> 
                                        </linearGradient> 
                                    </defs> 
                                    <circle id="user-info-7-back" class="background" stroke-linecap="round"></circle>
                                    <circle id="user-info-7-line" stroke-linecap="round"></circle>
                                </svg>
                            </div>
                            <i id="user-info-7-icon" class="fa-solid fa-check-double"></i>
                        </div>
                        <span id="user-info-7-day">...</span>
                    </div>
                    <div class="wrapper-tue">
                        <div class="wrapper-progress-bar">
                            <div class="progress-bar">
                                <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 100 100"> 
                                    <defs>
                                        <linearGradient id="gradient-color"> 
                                            <stop offset= "0%" stop-color="#DA22FF" />
                                            <stop offset="1001" stop-color="#9733EE" /> 
                                        </linearGradient> 
                                    </defs> 
                                    <circle id="user-info-6-back" class="background" stroke-linecap="round"></circle>
                                    <circle id="user-info-6-line" stroke-linecap="round"></circle>
                                </svg>
                            </div>
                            <i id="user-info-6-icon" class="fa-solid fa-check-double"></i>
                        </div>
                        <span id="user-info-6-day">...</span>
                    </div>
                    <div class="wrapper-wed">
                        <div class="wrapper-progress-bar">
                            <div class="progress-bar">
                                <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 100 100"> 
                                    <defs>
                                        <linearGradient id="gradient-color"> 
                                            <stop offset= "0%" stop-color="#DA22FF" />
                                            <stop offset="1001" stop-color="#9733EE" /> 
                                        </linearGradient> 
                                    </defs> 
                                    <circle id="user-info-5-back" class="background" stroke-linecap="round"></circle>
                                    <circle id="user-info-5-line" stroke-linecap="round"></circle>
                                </svg>
                            </div>
                            <i id="user-info-5-icon" class="fa-solid fa-check-double"></i>
                        </div>
                        <span id="user-info-5-day">...</span>
                    </div>
                    <div class="wrapper-thu">
                        <div class="wrapper-progress-bar">
                            <div class="progress-bar">
                                <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 100 100"> 
                                    <defs>
                                        <linearGradient id="gradient-color"> 
                                            <stop offset= "0%" stop-color="#DA22FF" />
                                            <stop offset="1001" stop-color="#9733EE" /> 
                                        </linearGradient> 
                                    </defs> 
                                    <circle id="user-info-4-back" class="background" stroke-linecap="round"></circle>
                                    <circle id="user-info-4-line" stroke-linecap="round"></circle>
                                </svg>
                            </div>
                            <i id="user-info-4-icon" class="fa-solid fa-check-double"></i>
                        </div>
                        <span id="user-info-4-day">...</span>
                    </div>
                    <div class="wrapper-fri">
                        <div class="wrapper-progress-bar">
                            <div class="progress-bar">
                                <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 100 100"> 
                                    <defs>
                                        <linearGradient id="gradient-color"> 
                                            <stop offset= "0%" stop-color="#DA22FF" />
                                            <stop offset="1001" stop-color="#9733EE" /> 
                                        </linearGradient> 
                                    </defs> 
                                    <circle id="user-info-3-back" class="background" stroke-linecap="round"></circle>
                                    <circle id="user-info-3-line" stroke-linecap="round"></circle>
                                </svg>
                            </div>
                            <i id="user-info-3-icon" class="fa-solid fa-check-double"></i>
                        </div>
                        <span id="user-info-3-day">...</span>
                    </div>
                    <div class="wrapper-sat">
                        <div class="wrapper-progress-bar">
                            <div class="progress-bar">
                                <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 100 100"> 
                                    <defs>
                                        <linearGradient id="gradient-color"> 
                                            <stop offset= "0%" stop-color="#DA22FF" />
                                            <stop offset="1001" stop-color="#9733EE" /> 
                                        </linearGradient> 
                                    </defs> 
                                    <circle id="user-info-2-back" class="background" stroke-linecap="round"></circle>
                                    <circle id="user-info-2-line" stroke-linecap="round"></circle>
                                </svg>
                            </div>
                            <i id="user-info-2-icon" class="fa-solid fa-check-double"></i>
                        </div>
                        <span id="user-info-2-day">...</span>
                    </div>
                    <div class="wrapper-sun">
                        <div class="wrapper-progress-bar">
                            <div class="progress-bar">
                                <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 100 100"> 
                                    <defs>
                                        <linearGradient id="gradient-color"> 
                                            <stop offset= "0%" stop-color="#DA22FF" />
                                            <stop offset="1001" stop-color="#9733EE" /> 
                                        </linearGradient> 
                                    </defs> 
                                    <circle id="user-info-1-back" class="background" stroke-linecap="round"></circle>
                                    <circle id="user-info-1-line" stroke-linecap="round"></circle>
                                </svg>
                            </div>
                            <i id="user-info-1-icon" class="fa-solid fa-check-double"></i>
                        </div>
                        <span id="user-info-1-day">...</span>
                    </div>
                </div>
                <div class="steps-card">
                    <span>STEPS</span>
                    <div class="wrapper-steps-count">
                        <div class="wrapper-count">
                            <span id="steps-card-done">?</span><span id="steps-card-undone">/?</span>
                        </div>
                        <span class="wrapper-percent" id="steps-card-percentage">?%</span>
                    </div>
                    <div class="bar"><div id="bar-done" class="bar-done"></div></div>
                </div>
            </div>
            <div class="wrapper-user-menu-achievements">
            </div>
            <div class="wrapper-user-menu-settings">
                <div class="user-menu-setting-you">
                    <div class="user-menu-settings-content-title">More options</div>
                    <div class="wrapper-btn">
                        <button class="list-style" type="button"><i class="fa-regular fa-pen-to-square"></i><span>Edit profile</span></button>
                    </div>
                    <div class="wrapper-btn">
                        <button class="list-style" type="button"><i class="fa-solid fa-clock-rotate-left"></i><span>History</span></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <header class="wrapper-header">
        <div class="wrapper-mobile-header">
            <div class="wrapper-avatar">
                <button data-action="showTarget" data-target="#user-menu" class="buttons-basic-efects" title="User Menu" id="btn-user-menu">
                    <img id="user-avatar" src="/img/user-default-avatar.png" alt="user avatar">
                </button>
                <div class="wrapper-username">
                    <span id="username"></span>
                </div>
            </div>
            <div class="wrapper-configuration">
                <button data-action="showConfigs" data-target="#configs-menu" id="btn-configs">
                    <i title="Configurations" class="fa-solid fa-toolbox"></i>
                </button>
            </div>
        </div>
        <div class="wrapper-pc-header">
            <div class="wrapper-makeday-icon">
                <img src="/icons/MakeDay_Icon.png" alt="">
                <span class="basic-shadow-size1">MakeDay</span>
            </div>
            <div class="wrapper-configuration">
                <button data-action="showConfigs" data-target="#configs-menu" id="btn-configs-pc">
                    <i title="Configurations" class="fa-solid fa-toolbox"></i>
                </button>
            </div>
        </div>
    </header>
    <main>
        <section id="left-side-bar">

            <div id="favorites-wrapper" class="wrapper-Card side-wrappers" style="opacity: 0; position: absolute;" inert>
                <h2>Favorites <button data-action="create" data-group-id="1" class="buttuns-purple-style" type="button" title="Create a new note on group"><i class="fa-solid fa-square-plus"></i></button></h2>
                <div id="favorites-content" class="wrapper-card-content">
                    <!--add with a filter-->
                </div>
            </div>
            
            <div class="wrapper-all-tasks side-wrappers">
                <h2>All Tasks <button data-action="createNote" data-target="#new-note" data-parent-id="all-notes" class="buttuns-purple-style" type="button" title="Create a new note on group"><i class="fa-solid fa-square-plus"></i></button></h2>
                <div id="all-tasks-content-wrapper" class="all-tasks-content-wrapper basic-content">
                    <!--add with a filter-->
                </div>
            </div>
        </section>
        <div class="wrapper-main-content">
            <section id="welcome-workspace" class="welcome-wrapper" style="opacity: 0;" inert>
                <div class="wrapper-image-empty-state">
                    <img src="/img/notesEmptyState.png" alt="Your workspace is empty. Create your first note and start organizing your ideas.">
                </div>
                <div class="wrapper-button-empty-state">
                    <button data-action="createNote" data-target="#new-note" data-parent-id="all-notes" class="buttuns-purple-style"><span>Create your first note</span><i class="fa-solid fa-plus"></i></button>
                </div>
            </section>
            <section class="wrapper-smart-dashboard" id="smart-dashboard" style="opacity: 0;" inert>
                <div class="wrapper-smart-presentation">
                    <p id="presentation-header-name">
                        Good morning, ? 👋
                    </p>
                    <p>
                        <span><i class="fa-solid fa-calendar-day"></i>Today is</span><span id="presentation-header-day">?, ? ?th</span>
                    </p>
                </div>
                <div class="wrapper-smart-history">
                    <!--add with a filter-->
                </div>
            </section>
            <section id="all-note" class="note-wrapper" style="opacity: 0;" inert>
                <div class="content-wrapper">
                    <div class="wrapper-note-btn">
                        <button data-action="returnTo" data-target="#left-side-bar" class="buttons-icon-efect note-menu-btn" id="btn-return-page"><i class="fa-solid fa-angles-left"></i></button>
                        <button data-action="open-config" data-group-id="1" class="buttons-icon-efect note-menu-btn" id="btn-note-option"><i class="fa-solid fa-ellipsis"></i></button>
                    </div>
                    <div class="wrapper-info">
                        <div class="wrapper-img" id="note-image-wrapper">
                            <img id="note-image" draggable="false" src="/img/Tarefas-capa.jpg" alt="">
                        </div>
                        <div class="wrapper-icon" id="note-icon-wrapper">
                            <i id="note-icon" class="fa-solid fa-circle-notch"></i>
                        </div>
                        <div class="wrapper-title">
                            <span id="note-title">loading...</span>
                        </div>
                    </div>
                    <div id="note-content" class="note-content">
                        
                    </div>
                </div>
            </section>
            <section id="new-category" class="new-section" style="opacity: 0;" inert>
                <div class="wrapper-new-category-title">
                    <span>Create a new category</span>
                </div>
                <div class="new-category-options-wrapper">
                    <div class="error-wrapper" >
                        <span id="create-new-category-error">
                            
                        </span>
                    </div>
                    <input type="text" class="input-new-type-name" id="input-new-category-name" placeholder="Category Name">
                    <div class="wrapper-category-styles">
                        <span>Choose a style:</span>
                        <div class="new-category-styles">
                            <button  data-action="select-new-category"  data-category-style="List" class="buttuns-purple-style" type="button">List</button>
                            <button  data-action="select-new-category"  data-category-style="Card" class="buttuns-purple-style select-style" type="button">Card</button>
                        </div>
                    </div>
                    <div class="wrapper-category-result">
                        <span>Result:</span>
                        <div id="new-category-style-card" class="wrapper-Card side-wrappers">
                            <h2 class="category-result-title">Category Name<button disabled class="buttuns-purple-style" type="button" title="Create a new note on group"><i class="fa-solid fa-square-plus"></i></button></h2>
                            <div class="wrapper-card-content">
                                <div class="card-square list-style">
                                    <div class="card-icon"><i class="fa-solid fa-1"></i></div>
                                    <img class="card-background" src="/img/Afazeres-test.jpg" alt="Afazeres Background">
                                    <h3 class="card-text">Item</h3>
                                </div>
                                <div class="card-square list-style">
                                    <div class="card-icon"><i class="fa-solid fa-2"></i></div>
                                    <img class="card-background" src="/img/ListaDeCompras-test.jpg" alt="Lista de compras Background">
                                    <h3 class="card-text">Item</h3>
                                </div>
                                <div class="card-square list-style">
                                    <div class="card-icon"><i class="fa-solid fa-3"></i></div>
                                    <img class="card-background" src="/img/computação-test.jpg" alt="Teoria da Computação Background">
                                    <h3 class="card-text">Item</h3>
                                </div>
                            </div>
                        </div>
                        <div id="new-category-style-list" class="wrapper-list side-wrappers" style="opacity: 0; position: absolute;" inet>
                            <h2  class="category-result-title">Category Name<button disabled class="buttuns-purple-style" type="button" title="Create a new note on group"><i class="fa-solid fa-square-plus"></i></button></h2>
                            <div class="list-content-wrapper basic-content">
                                <div class="list-style basic-list">
                                    <div class="basic-icon-list"><i class="fa-solid fa-1"></i></div>
                                    <h3 class="list-text">Item</h3>
                                    <button disabled class="buttons-basic-efects" type="button"><i class="fa-solid fa-ellipsis"></i></button>
                                </div>
                                <div class="list-style basic-list">
                                    <div class="basic-icon-list"><i class="fa-solid fa-2"></i></div>
                                    <h3 class="list-text">Item</h3>
                                    <button disabled class="buttons-basic-efects" type="button"><i class="fa-solid fa-ellipsis"></i></button>
                                </div>
                                <div class="list-style basic-list">
                                    <div class="basic-icon-list"><i class="fa-solid fa-3"></i></div>
                                    <h3 class="list-text">Item</h3>
                                    <button disabled class="buttons-basic-efects" type="button"><i class="fa-solid fa-ellipsis"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="wrapper-submit-new">

                        <button data-action="createNewCategory" id="create-new-category" class="buttuns-purple-style"><i class="fa-solid fa-check"></i></button>

                    </div>
                </div>
            </section>
            <section id="new-note" class="new-section" style="opacity: 0;" inert>
                <div class="wrapper-new-category-title">
                    <span>Create a new note</span>
                </div>
                <div class="new-category-options-wrapper">
                    <div class="error-wrapper" >
                        <span id="create-new-note-error-input">
                            
                        </span>
                    </div>
                    <input class="input-new-type-name" type="text" id="input-new-note-name" placeholder="Note Name">
                    <div class="wrapper-icons-new-note">
                        <div class="wrapper-icons-btn">

                            <span>Choose one:</span>
                            <div class="wrapper-icon-or-emoji">
                                <button id="newNoteIconBtn" data-action="toggleIconsEmojis" class="buttuns-purple-style select-style" type="button">Icons</button>
                                <span>Or</span>
                                <button id="newNoteEmojiBtn" data-action="toggleIconsEmojis" class="note-btn buttuns-purple-style" type="button">Emojis</button>
                            </div>

                        </div>
                        <div class="new-notes-icon-wrapper">
                            <div class="new-note-icons" id="new-note-icons">
                            </div>
                            <div class="new-note-emojis" id="new-note-emojis" style="opacity: 0;position: absolute;" inert>
                            </div>
                            <div class="load-more-wrapper">
