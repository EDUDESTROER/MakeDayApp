                                        <i class="fa-solid fa-hourglass-start"></i>
                                    </div>
                                    <span>1 year</span>
                                </div>
                                <div class="wrapper-performance">
                                    <div class="wrapper-icon-performance">
                                        <i class="fa-solid fa-arrow-trend-down"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="important-list list-style">
                            <div class="important-list-note-content">
                                <div class="basic-icon-list"><i class="fa-solid fa-bag-shopping"></i></div>
                                <h3 class="list-text">lista de compras</h3>
                                <button class="buttons-basic-efects" type="button"><i class="fa-solid fa-ellipsis"></i></button>
                            </div>
                            <div class="important-content">
                                <div class="wrapper-steps">
                                    <span>No steps</span>
                                </div>
                                <div class="wrapper-remaining-time">
                                    <div class="wrapper-icon-remaining-time">
                                        <i class="fa-solid fa-hourglass-start"></i>
                                    </div>
                                    <span>6 years</span>
                                </div>
                                <div class="wrapper-performance">
                                    <div class="wrapper-icon-performance">
                                        <i class="fa-solid fa-arrow-trend-up"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </section>
        </div>
    </main>
    <footer>
