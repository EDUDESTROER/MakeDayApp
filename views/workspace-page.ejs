                                    <div class="basic-icon-list"><i class="fa-solid fa-1"></i></div>
                                    <h3 class="list-text">Item</h3>
                                    <button disabled class="buttons-basic-efects" type="button"><i class="fa-solid fa-ellipsis"></i></button>
                                </div>
